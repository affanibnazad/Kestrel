# Kestrel Environment Variables Configuration Template
# Copy this file to .env.local for local development or set these variables in Vercel / hosting provider.
# NEVER commit .env.local or any real secrets to source control.

# ==============================================================================
# 1. Supabase Configuration (Required for Client and Server)
# ==============================================================================
# Found in: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase project URL (must start with https://)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Supabase publishable key (starts with sb_publishable_)
# Or NEXT_PUBLIC_SUPABASE_ANON_KEY: Supabase anon public key (legacy JWT format)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_key_change_me
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...

# ==============================================================================
# 2. Server Security & Internal Operations (Required for Production Backend)
# ==============================================================================
# MAIL_SERVER_SECRET: Shared internal secret between Kestrel Next.js server and Supabase RPCs.
# Must be at least 32 characters long. Generate with: openssl rand -hex 32
MAIL_SERVER_SECRET=change_this_to_a_secure_random_32_character_string

# ==============================================================================
# 3. Contact & Communications (Required for Contact Form /api/contact)
# ==============================================================================
# RESEND_API_KEY: Resend API key for delivering contact form messages (starts with re_)
RESEND_API_KEY=re_example_api_key

# CONTACT_INBOX: Email address where contact form submissions are delivered
CONTACT_INBOX=founder@norvenstudio.com

# ==============================================================================
# 4. AI & Assistant Fallback (Optional)
# ==============================================================================
# ANTHROPIC_API_KEY: Fallback Anthropic Claude API key for Kestrel Assistant.
# Note: In production, teams can configure their own AI keys via the Owner/Connections panel.
ANTHROPIC_API_KEY=sk-ant-example-key

# ==============================================================================
# 5. Dedicated Email Verifier (Optional)
# ==============================================================================
# If running an external Kestrel verifier instance:
VERIFIER_URL=https://verifier.kestrelleads.com
VERIFIER_SECRET=change_this_to_a_secure_random_verifier_secret

# ==============================================================================
# 6. Sentry Error Monitoring & Observability (Optional)
# ==============================================================================
# NEXT_PUBLIC_SENTRY_DSN: Client and server error monitoring DSN
# NEXT_PUBLIC_SENTRY_DSN=https://example@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=sntrys_example_token
# SENTRY_ORG=norven-studio
# SENTRY_PROJECT=kestrel
